{
	admin off
	auto_https off
}

# Wayne's Music — local port 8091 (Jori's uses 8090 on the same Mac).
# Tailscale (second URL on this machine):
#   tailscale serve --bg --https=8443 http://127.0.0.1:8091
#   https://<machine>.<tailnet>.ts.net:8443/
# Start from this folder so music/ is the song library:
#   caddy run --config Caddyfile
:8091 {
	bind 127.0.0.1
	handle /music/* {
		uri strip_prefix /music
		root * music
		header Cache-Control "no-cache"
		file_server
	}

	handle /catalog.json {
		root * music
		header Cache-Control "no-store"
		file_server
	}

	handle /youtube-catalog.json {
		rewrite * /catalog.json
		root * youtube
		header Cache-Control "no-store"
		file_server
	}

	handle /api/youtube-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://www.youtube.com {
			header_up Host www.youtube.com
			header_up User-Agent "Mozilla/5.0"
		}
	}

	handle /api/soundcloud-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://soundcloud.com {
			header_up Host soundcloud.com
		}
	}

	handle /sw.js {
		root * web
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * web
		encode gzip
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		file_server
	}
}
