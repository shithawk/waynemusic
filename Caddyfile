{
	admin off
	auto_https off
}

# Wayne's Music — local port 8091 (Jori's uses 8090 on the same Mac).
# Tailscale (second URL on this machine):
#   tailscale serve --bg --https=8443 http://127.0.0.1:8091
#   https://<machine>.<tailnet>.ts.net:8443/
# Start from this folder so relative roots (web/, music/) resolve correctly:
#   cd /Users/jacobward/waynesmusic && caddy run --config Caddyfile
:8091 {
	bind 127.0.0.1
	handle /music/*.webm {
		uri strip_prefix /music
		root * music
		header Content-Type audio/webm
		header Cache-Control "no-cache"
		file_server
	}

	handle /music/* {
		uri strip_prefix /music
		root * music
		header Cache-Control "no-cache"
		file_server
	}

	handle /catalog.json {
		root * music
		header Cache-Control "no-store"
		file_server
	}

	handle /youtube-catalog.json {
		rewrite * /catalog.json
		root * youtube
		header Cache-Control "no-store"
		file_server
	}

	handle /api/youtube-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://www.youtube.com {
			header_up Host www.youtube.com
			header_up User-Agent "Mozilla/5.0"
		}
	}

	handle /api/soundcloud-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://soundcloud.com {
			header_up Host soundcloud.com
		}
	}


	handle /api/soundcloud-v2/* {
		uri strip_prefix /api/soundcloud-v2
		reverse_proxy https://api-v2.soundcloud.com {
			header_up Host api-v2.soundcloud.com
		}
	}
	handle /api/suggest-artists {
		reverse_proxy 127.0.0.1:8096
	}

	handle /sw.js {
		root * web
		header Cache-Control "no-store"
		file_server
	}

	handle {
		root * web
		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "SAMEORIGIN"
		}
		encode gzip
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type application/manifest+json
		file_server
	}
}
