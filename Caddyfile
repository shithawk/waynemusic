{
	admin off
	auto_https off
}

# Localhost only. Port 8080 is already used by another app on this Mac.
# Tailscale Serve sends the tailnet hostname, so this site accepts that Host
# while the socket stays on 127.0.0.1.
#   tailscale serve --bg 8090
:8090 {
	bind 127.0.0.1
	handle /music/* {
		uri strip_prefix /music
		root * "{env.HOME}/Music/WaynesMusic"
		header Cache-Control "no-cache"
		file_server
	}

	handle /catalog.json {
		root * "{env.HOME}/Music/WaynesMusic"
		header Cache-Control "no-store"
		file_server
	}

	handle /api/youtube-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://www.youtube.com {
			header_up Host www.youtube.com
		}
	}

	handle /api/soundcloud-oembed {
		rewrite * /oembed?format=json&{http.request.uri.query}
		reverse_proxy https://soundcloud.com {
			header_up Host soundcloud.com
		}
	}

	handle {
		root * web
		encode gzip
		header /manifest.webmanifest Content-Type application/manifest+json
		file_server
	}
}
